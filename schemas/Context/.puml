@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_LEFT_RIGHT()

Person(user, "Пользователь", "Самостоятельно подключает устройства, настраивает сценарии умного дома, управляет отоплением, светом, воротами и просматривает телеметрию через веб/мобильное приложение.")

System(warmhouse, "WarmHouse SaaS", "Экосистема умного дома: самообслуживание, каталог модулей и устройств партнёров, сценарии, телеметрия и управление приборами по стандартным протоколам.")

System_Ext(partnerDevices, "Устройства партнёров", "Датчики, реле, камеры, контроллеры отопления/света/ворот. Подключаются пользователем к облаку по стандартным протоколам (MQTT, HTTP, и др.).")

SystemDb_Ext(databases, "Базы данных", "PostgreSQL и др. — пользователи, дома, устройства, сценарии, телеметрия.")

System_Ext(notifications, "Каналы уведомлений", "Email, SMS, push — уведомления пользователю.")

Rel(user, warmhouse, "Использует в режиме самообслуживания (веб/мобильное приложение)", "HTTPS")
Rel(partnerDevices, warmhouse, "Регистрируются пользователем, отправляют телеметрию, получают команды", "MQTT/HTTP/стандартные протоколы")
Rel(warmhouse, databases, "Читает и записывает данные", "SQL/TCP")
Rel(warmhouse, notifications, "Отправляет уведомления", "HTTPS/API")

@enduml